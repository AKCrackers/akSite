PORT=4000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# =========================
# MYSQL DATABASE
# =========================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-your-mysql-password
DB_NAME=ak_crackers
# Set to true for most hosted MySQL providers (PlanetScale, Aiven, etc.)
DB_SSL=false
DEMO_PAYMENT=true
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxx
ORDER_RESERVATION_MINUTES=30

# Separate admin credentials
ADMIN_EMAIL=replace-with-your-admin-email
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=AK Crackers Admin

# =========================
# MONGODB DATABASE
# =========================
# Use the exact URI from your MongoDB provider. Never commit real credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?appName=Cluster0
# Local workaround only when Atlas presents a certificate not yet valid for the system clock.
# Keep false in production; the server rejects true when NODE_ENV=production.
MONGODB_TLS_ALLOW_INVALID_CERTIFICATES=false

# =========================
# EMAIL BILL NOTIFICATIONS
# =========================
# SMTP can be Gmail, Outlook, Zoho, your hosting mail server, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=akcrackers9585@gmail.com
SMTP_PASS=password
SMTP_FROM="AK CRACKERS <akcrackers9585@gmail.com>"
# Admin receives a copy of every confirmed order bill.
ADMIN_NOTIFICATION_EMAIL=akcrackers9585@gmail.com

# =========================
# WHATSAPP BILL NOTIFICATIONS
# =========================
# Meta WhatsApp Cloud API. Leave blank/disabled until configured.
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
ADMIN_WHATSAPP_NUMBER=919999999999
# Optional: approved Meta template name. If set, the system sends the PDF
# as a document header in that template. Template must have a document header
# and 3 body text parameters: customer name, order id, total.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

